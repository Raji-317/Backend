<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>instagram</title>
</head>
<body></body>
    <h2>INTERFACE OF AN INSTAGRAM USING EJS</h2>
    <p>This is an instagram page <%=username%></p>
    <button>Follow</button>
    <button>Messages</button>
    <button>Posts</button>
    <p>Followers</p>
    <ul>
          <% for(let name of followers) { %>
            <li><%=name%></li>
          <% } %>
    </ul>


